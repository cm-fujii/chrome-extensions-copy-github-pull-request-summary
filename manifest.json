{
  "manifest_version": 3,
  "name": "Copy GitHub Pull Request Summary",
  "version": "1.0.0",
  "description": "GitHub の Pull Request の URL・タイトル・ブランチ・Description を Markdown 形式でクリップボードにコピーします。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "scripting", "clipboardWrite", "storage"],
  "host_permissions": ["https://github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html"
  }
}
